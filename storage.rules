rules_version = '2';

// Journal screenshots for Pro cross-device sync. Each user can only read/write
// images under their own path. Writes are limited to images under 5MB, and
// (since 18 Aug 2026) to accounts whose Firestore users/{uid}.isPro is true —
// the same Stripe-webhook-owned flag the Cloud Functions trust. The client
// already only uploads for Pro; this makes it true server-side too. Reads and
// deletes stay ownership-only so a lapsed subscriber keeps their own images.
// A denied write falls back to local storage in the client (Journal.tsx).
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/journal/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && firestore.get(/databases/(default)/documents/users/$(userId)).data.isPro == true;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
